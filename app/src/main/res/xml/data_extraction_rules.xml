<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Exclude device-bound Android Keystore encrypted preferences to prevent restore crashes (H1) -->
        <exclude domain="sharedpref" path="ai_secure_prefs.xml" />

        <!-- Exclude unencrypted Room health/fitness database files from cloud backup -->
        <exclude domain="database" path="gymflow_database" />
        <exclude domain="database" path="gymflow_database-wal" />
        <exclude domain="database" path="gymflow_database-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude device-bound Keystore encrypted preferences during device-to-device transfer (H1) -->
        <exclude domain="sharedpref" path="ai_secure_prefs.xml" />
        <exclude domain="database" path="gymflow_database" />
        <exclude domain="database" path="gymflow_database-wal" />
        <exclude domain="database" path="gymflow_database-shm" />
    </device-transfer>
</data-extraction-rules>
